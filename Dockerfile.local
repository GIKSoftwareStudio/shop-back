# استفاده از Image قبلی پروژه به‌عنوان پایه محلی
FROM shop-back:updated

# بازگشت به کاربر root برای آماده‌سازی فایل‌ها
USER root

WORKDIR /var/www/html

# حذف نسخه قبلی برنامه برای جلوگیری از باقی ماندن فایل‌های حذف‌شده
RUN find . -mindepth 1 -maxdepth 1 \
    ! -name '.git' \
    -exec rm -rf {} +

# کپی نسخه جدید پروژه
COPY . .

# نصب وابستگی‌ها و آماده‌سازی Laravel
RUN composer install \
    --no-dev \
    --no-interaction \
    --prefer-dist \
    --optimize-autoloader \
    --no-scripts \
    && composer dump-autoload --optimize \
    && mkdir -p storage/framework/cache \
                storage/framework/sessions \
                storage/framework/views \
                storage/logs \
                bootstrap/cache \
                database \
    && chmod -R a+rX /var/www/html \
    && chown -R www-data:www-data storage bootstrap/cache database

# اجرای برنامه با کاربر غیر root
USER www-data

EXPOSE 8000

CMD ["php", "artisan", "serve", "--host=0.0.0.0", "--port=8000"]
